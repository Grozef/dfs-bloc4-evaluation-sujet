[Unit]
Description=OpsTrack Dispatch Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/opstrack/microservices/dispatch-dashboard
Environment=NODE_ENV=production
EnvironmentFile=/var/www/opstrack/microservices/dispatch-dashboard/.env.local
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
